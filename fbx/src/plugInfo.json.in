{
    "Plugins": [
        {
            "Info": {
                "SdfMetadata": {
                    "fbxAssetsPath": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation:": "Path to store assets to, instead of resolving from the source file",
                        "type": "string"
                    },
                    "fbxPhong": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation:": "Whether to import phong (by default conversion only keeps the diffuse component)",
                        "type": "bool"
                    },
                    "fbxAnimationStacks": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation:": "Whether to import multiple animation stacks (by default only the first stack is imported)",
                        "type": "bool"
                    },
                    "animationMode": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation": "Node transform sampling: keyframes, adaptive (default), or resample at animationSampleRate (scene FPS by default) then reduce. Skeletal sampling is unchanged.",
                        "type": "string"
                    },
                    "animationPositionTolerance": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation": "Adaptive/resample translation tolerance in meters, accounting for parent scale (default 0.0001).",
                        "type": "string"
                    },
                    "animationSampleRate": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation": "Target sample rate in Hz for resample mode (default 0 uses scene FPS). Does not change playback FPS or clip duration; endpoints are retained.",
                        "type": "string"
                    },
                    "animationRotationTolerance": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation": "Adaptive/resample local rotation tolerance in degrees (default 0.01, less than 180).",
                        "type": "string"
                    },
                    "animationScaleTolerance": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation": "Adaptive/resample relative local scale tolerance with a unit floor (default 0.00001).",
                        "type": "string"
                    },
                    "animationMaxSampleRate": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation": "Maximum frequency of extra adaptive subdivisions in Hz (default 0 disables the rate cap). Authored keys survive sampling; error-based channel reduction follows. Limits that prevent meeting tolerance issue warnings.",
                        "type": "string"
                    },
                    "importLights": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation": "Whether to import lights from FBX (default true).",
                        "type": "bool"
                    },
                    "fbxOriginalColorSpace": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation:": "Is the original colorspace in linear or sRGB",
                        "type": "string"
                    },
                    "triangulateMeshes": {
                        "appliesTo": [ "prims" ],
                        "displayGroup": "Core",
                        "documentation:": "Whether to perform mesh triangulation at import",
                        "type": "bool"
                    }
                },
                "Types": {
                    "UsdFbxFileFormat": {
                        "bases": ["SdfFileFormat"],
                        "displayName": "Autodesk® FBX®",
                        "extensions": [ "fbx" ],
                        "formatId": "fbx",
                        "primary": true,
                        "target": "usd"
                    },
                    "adobe::usd::FbxResolver" : {
                        "bases": [ "ArPackageResolver" ],
                        "extensions": [ "fbx", "FBX", "Fbx" ]
                    }
                }
            },
            "LibraryPath": "@PLUG_INFO_LIBRARY_PATH@",
            "Name": "usdFbx_plugin",
            "ResourcePath": "resources",
            "Root": "..",
            "Type": "library"
        }
    ]
}
